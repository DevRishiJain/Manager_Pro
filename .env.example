# ==============================================================================
# Restaurant Dining OS — Environment Configuration
# Copy this file to .env and replace placeholder values with your actual credentials.
# ==============================================================================

# Application Environment & Server Port
APP_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080

# Database Configuration (PostgreSQL 16+)
DATABASE_URL=postgres://localhost:5432/table_manager_test?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# Authentication & Security
# IMPORTANT: In production, generate a secure random 32+ byte string!
JWT_SECRET=super-secure-dining-os-jwt-secret-key-32b
AUTH_TOKEN_TTL_HOURS=24
GUARD_TOKEN_TTL_HOURS=12

# Razorpay Payment Gateway Credentials
# Find these in your Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Object Storage & File Uploads (Menu images, payment proofs)
# STORAGE_TYPE options: 's3' (production AWS), 'local' (disk storage), or 'memory' (testing/dev)
STORAGE_TYPE=s3
STORAGE_UPLOAD_DIR=./uploads
STORAGE_MAX_UPLOAD_BYTES=5242880

# Amazon Web Services (AWS S3 & SMS OTP Services)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA_YOUR_AWS_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE
AWS_S3_BUCKET_NAME=tableos-dining-assets-prod
AWS_S3_ENDPOINT=
AWS_CLOUDFRONT_DOMAIN=https://assets.table-manager.internal
AWS_SNS_SENDER_ID=TABLEOS
AWS_PINPOINT_APP_ID=

# Background Worker & Sweeper Intervals
OUTBOX_POLL_INTERVAL_MS=1000
INACTIVITY_SWEEPER_INTERVAL_MS=5000
FAILED_PAYMENT_SWEEP_MINUTES=15

# Default Restaurant Business Rules & Risk Engine Limits
# 500000 minor units = 5000.00 INR
DEFAULT_HIGH_VALUE_THRESHOLD_MINOR=500000
DEFAULT_RAPID_ORDER_JUMP_FACTOR=3
DEFAULT_EXIT_PASS_OTP_TTL_MINUTES=120
DEFAULT_FIRST_ORDER_OTP_TTL_MINUTES=15

# Platform Super Admin bootstrap (optional)
# When set, a hidden platform restaurant and a SUPER_ADMIN account with these
# credentials are ensured at server startup (idempotent).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
